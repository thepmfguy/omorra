{%- if section.settings.enabled and section.settings.message != blank -%}
  <div class="announcement-bar" style="background:{{ section.settings.bg }};color:{{ section.settings.text }};">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" style="color:inherit;text-decoration:none;">{{ section.settings.message }}</a>
    {%- else -%}
      {{ section.settings.message }}
    {%- endif -%}
  </div>
{%- endif -%}
{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show announcement bar", "default": false },
    { "type": "text", "id": "message", "label": "Message", "default": "The first release: Wisdom, Practice, Nourish" },
    { "type": "url", "id": "link", "label": "Link (optional)" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#3d2418" },
    { "type": "color", "id": "text", "label": "Text", "default": "#faf5ec" }
  ]
}
{% endschema %}
