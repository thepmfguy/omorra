{%- liquid
  assign img = section.settings.image
  assign img_m = section.settings.image_mobile
-%}
<section
  class="hero-full hero-pos--{{ section.settings.text_position }} hero-align--{{ section.settings.text_align }}{% if section.settings.animate %} hero-animate{% endif %}"
  style="--hero-h:{{ section.settings.height }}vh;--hero-h-m:{{ section.settings.height_mobile }}vh;--hero-text:{{ section.settings.text_color }};--hero-overlay:{{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  <div class="hero-full__media">
    {%- if img != blank -%}
      <img
        class="hero-full__img hero-full__img--d"
        src="{{ img | image_url: width: 2000 }}"
        srcset="{{ img | image_url: width: 900 }} 900w, {{ img | image_url: width: 1400 }} 1400w, {{ img | image_url: width: 2000 }} 2000w, {{ img | image_url: width: 2600 }} 2600w"
        sizes="100vw"
        alt="{{ img.alt | default: section.settings.heading | escape }}"
        width="{{ img.width }}" height="{{ img.height }}"
        loading="eager" fetchpriority="high"
        {% if img.presentation.focal_point %}style="object-position:{{ img.presentation.focal_point }};"{% endif %}
      >
    {%- else -%}
      <img class="hero-full__img hero-full__img--d" src="{{ 'hero-still.png' | asset_url }}" alt="{{ section.settings.heading | escape }}" loading="eager" fetchpriority="high">
    {%- endif -%}
    {%- if img_m != blank -%}
      <img
        class="hero-full__img hero-full__img--m"
        src="{{ img_m | image_url: width: 1200 }}"
        srcset="{{ img_m | image_url: width: 600 }} 600w, {{ img_m | image_url: width: 900 }} 900w, {{ img_m | image_url: width: 1200 }} 1200w"
        sizes="100vw"
        alt="{{ img_m.alt | default: section.settings.heading | escape }}"
        width="{{ img_m.width }}" height="{{ img_m.height }}"
        loading="eager" fetchpriority="high"
        {% if img_m.presentation.focal_point %}style="object-position:{{ img_m.presentation.focal_point }};"{% endif %}
      >
    {%- endif -%}
  </div>
  {%- if section.settings.overlay_opacity > 0 -%}<div class="hero-full__scrim" aria-hidden="true"></div>{%- endif -%}
  <div class="hero-full__inner container">
    <div class="hero-full__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hero-full__eyebrow eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="hero-full__heading font-display">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="hero-full__body">{{ section.settings.body }}</div>
      {%- endif -%}
      {%- if section.settings.cta_label != blank or section.settings.cta2_label != blank -%}
        <div class="hero-full__ctas">
          {%- if section.settings.cta_label != blank -%}
            <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="hero-cta">{{ section.settings.cta_label }}</a>
          {%- endif -%}
          {%- if section.settings.cta2_label != blank -%}
            <a href="{{ section.settings.cta2_link | default: routes.root_url }}" class="hero-cta hero-cta--ghost">{{ section.settings.cta2_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image (optional)" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay strength", "min": 0, "max": 70, "step": 5, "unit": "%", "default": 15 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A quieter way of living." },
    { "type": "richtext", "id": "body", "label": "Supporting copy", "default": "<p>Omorra brings together wisdom, practice and care through objects made for everyday ritual. Rooted in the traditions of India. Considered for life today.</p>" },
    { "type": "text", "id": "cta_label", "label": "Primary CTA", "default": "Discover Omorra" },
    { "type": "url", "id": "cta_link", "label": "Primary CTA link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary CTA" },
    { "type": "url", "id": "cta2_link", "label": "Secondary CTA link" },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "text_position", "label": "Text position", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "left" },
    { "type": "select", "id": "text_align", "label": "Text alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"}], "default": "left" },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#3d2418" },
    { "type": "range", "id": "height", "label": "Height (desktop)", "min": 55, "max": 92, "step": 1, "unit": "vh", "default": 78 },
    { "type": "range", "id": "height_mobile", "label": "Height (mobile)", "min": 60, "max": 100, "step": 1, "unit": "vh", "default": 82 },
    { "type": "checkbox", "id": "animate", "label": "Entrance animation", "default": true }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
