{%- liquid
  assign product = all_products[section.settings.product]
  assign img = section.settings.image
  if img == blank and product != blank
    assign img = product.featured_image
  endif
  assign heading = section.settings.heading
  if heading == blank and product != blank
    assign heading = product.title
  endif
-%}
<section class="featured-prod featured-prod--{{ section.settings.layout }}" style="--fp-bg:{{ section.settings.bg }};">
  <div class="featured-prod__grid">
    <div class="featured-prod__media">
      {%- if img != blank -%}
        <img src="{{ img | image_url: width: 1600 }}"
             srcset="{{ img | image_url: width: 800 }} 800w, {{ img | image_url: width: 1200 }} 1200w, {{ img | image_url: width: 1600 }} 1600w, {{ img | image_url: width: 2000 }} 2000w"
             sizes="(min-width:900px) 58vw, 100vw"
             alt="{{ img.alt | default: heading | escape }}"
             width="{{ img.width }}" height="{{ img.height }}" loading="lazy">
      {%- elsif section.settings.default_asset != blank -%}
        <img src="{{ section.settings.default_asset | asset_url }}" alt="{{ heading | escape }}" loading="lazy">
      {%- endif -%}
    </div>
    <div class="featured-prod__content">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if heading != blank -%}<h2 class="featured-prod__title font-display">{{ heading }}</h2>{%- endif -%}
      {%- if product != blank -%}
        {%- if product.available -%}
          {%- if section.settings.badge_label != blank -%}<p class="featured-prod__badge">{{ section.settings.badge_label }}</p>{%- endif -%}
        {%- else -%}
          <p class="featured-prod__badge featured-prod__badge--out">Sold out</p>
        {%- endif -%}
      {%- endif -%}
      {%- if section.settings.detail != blank -%}<p class="featured-prod__detail">{{ section.settings.detail }}</p>{%- endif -%}
      {%- if section.settings.show_price and product != blank -%}
        <p class="featured-prod__price">{{ product.price | money }}</p>
      {%- endif -%}
      {%- if product != blank -%}
        <div class="featured-prod__actions">
          <a href="{{ product.url }}" class="featured-prod__cta">{{ section.settings.cta_label | default: 'Discover' }}</a>
          {%- if section.settings.quick_add and product.available -%}
            <button type="button" class="btn-primary featured-prod__add" onclick="addToCart({{ product.selected_or_first_available_variant.id }},1)">Add to bag — {{ product.price | money }}</button>
          {%- endif -%}
        </div>
      {%- else -%}
        <p class="featured-prod__detail" style="color:var(--walnut);">Select a product in the theme editor.</p>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Featured Product",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "image", "label": "Image override (optional)" },
    { "type": "text", "id": "default_asset", "label": "Fallback image (bundled filename)" },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured / New at Omorra" },
    { "type": "text", "id": "heading", "label": "Heading override", "info": "Defaults to the product title" },
    { "type": "text", "id": "badge_label", "label": "Availability label", "default": "Available Now" },
    { "type": "textarea", "id": "detail", "label": "Short detail", "default": "Handwoven from natural kusha grass. A grounding foundation for your practice and stillness." },
    { "type": "checkbox", "id": "show_price", "label": "Show price", "default": false },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Discover the Mat" },
    { "type": "checkbox", "id": "quick_add", "label": "Show Add to bag button", "default": false },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "layout", "label": "Content position", "options": [{"value":"left","label":"Left"},{"value":"right","label":"Right"}], "default": "left" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#f1e7d3" }
  ],
  "presets": [{ "name": "Featured Product" }]
}
{% endschema %}
