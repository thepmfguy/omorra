<footer class="site-footer2">
  <div class="container footer2-row">
    <div class="footer2-brand">
      <a class="footer2-wordmark" href="{{ routes.root_url }}">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 320 | image_tag: alt: shop.name, class: 'footer2-logo', loading: 'lazy' }}
        {%- else -%}
          {{ shop.name | upcase }}
        {%- endif -%}
      </a>
      {%- if section.settings.tagline != blank -%}<p class="footer2-tag">{{ section.settings.tagline }}</p>{%- endif -%}
    </div>

    <nav class="footer2-nav" aria-label="Footer">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
      {%- if section.settings.show_policies -%}
        {%- if shop.refund_policy != blank -%}<a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a>{%- endif -%}
        {%- if shop.shipping_policy != blank -%}<a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a>{%- endif -%}
        {%- if shop.privacy_policy != blank -%}<a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a>{%- endif -%}
        {%- if shop.terms_of_service != blank -%}<a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a>{%- endif -%}
      {%- endif -%}
    </nav>

    <div class="footer2-meta">
      {%- if section.settings.instagram != blank -%}
        <a class="footer2-social" href="{{ section.settings.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/></svg>
        </a>
      {%- endif -%}
      {%- if section.settings.youtube != blank -%}
        <a class="footer2-social" href="{{ section.settings.youtube }}" target="_blank" rel="noopener" aria-label="YouTube">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M23 12s0-3.2-.4-4.7a2.5 2.5 0 0 0-1.76-1.77C19.28 5.1 12 5.1 12 5.1s-7.28 0-8.84.43A2.5 2.5 0 0 0 1.4 7.3C1 8.8 1 12 1 12s0 3.2.4 4.7a2.5 2.5 0 0 0 1.76 1.77C4.72 18.9 12 18.9 12 18.9s7.28 0 8.84-.43A2.5 2.5 0 0 0 22.6 16.7C23 15.2 23 12 23 12zM9.75 15.02V8.98L15 12l-5.25 3.02z"/></svg>
        </a>
      {%- endif -%}
      {%- if section.settings.pinterest != blank -%}
        <a class="footer2-social" href="{{ section.settings.pinterest }}" target="_blank" rel="noopener" aria-label="Pinterest">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 2.04c-5.5 0-9 3.55-9 7.86 0 2.4 1.28 4.42 3.2 5.17.3.12.44 0 .5-.28l.22-.9c.06-.24.03-.33-.14-.53-.4-.47-.65-1.08-.65-1.94 0-2.5 1.87-4.74 4.87-4.74 2.66 0 4.12 1.62 4.12 3.79 0 2.85-1.26 5.25-3.13 5.25-1.03 0-1.8-.85-1.55-1.9.3-1.25.87-2.6.87-3.5 0-.8-.43-1.48-1.33-1.48-1.05 0-1.9 1.09-1.9 2.55 0 .93.32 1.56.32 1.56l-1.26 5.35c-.37 1.58-.06 3.52-.03 3.71.01.12.16.15.23.06.1-.13 1.4-1.74 1.84-3.34l.71-2.78c.35.67 1.37 1.26 2.46 1.26 3.24 0 5.44-2.95 5.44-6.9 0-2.99-2.53-5.78-6.38-5.78z"/></svg>
        </a>
      {%- endif -%}
      {%- if section.settings.show_country -%}
        {%- if localization.available_countries.size > 1 -%}
          {%- form 'localization', class: 'footer2-loc' -%}
            <label for="footer-country" class="sr-only">Country/region</label>
            <select id="footer-country" name="country_code" onchange="this.form.submit()">
              {%- for country in localization.available_countries -%}
                <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</option>
              {%- endfor -%}
            </select>
          {%- endform -%}
        {%- else -%}
          <span class="footer2-country">{{ localization.country.name | upcase }}</span>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
  <div class="footer2-bottom">
    <p>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (optional, falls back to store name)" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "A quieter way of living." },
    { "type": "link_list", "id": "menu", "label": "Footer menu", "default": "footer" },
    { "type": "checkbox", "id": "show_policies", "label": "Append store policy links", "default": true },
    { "type": "url", "id": "instagram", "label": "Instagram URL" },
    { "type": "text", "id": "youtube", "label": "YouTube URL", "default": "https://www.youtube.com/channel/UCYO3dyal9dei03TJE98xRjw" },
    { "type": "text", "id": "pinterest", "label": "Pinterest URL", "default": "https://www.pinterest.com/omorralife" },
    { "type": "checkbox", "id": "show_country", "label": "Show country / currency", "default": true }
  ]
}
{% endschema %}
