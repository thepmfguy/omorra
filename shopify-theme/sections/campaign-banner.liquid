{%- liquid
  assign style = section.settings.style
-%}
{%- capture center -%}
  {%- if section.settings.eyebrow != blank -%}<p class="campaign__eyebrow eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
  {%- if section.settings.heading != blank -%}<h2 class="campaign__heading font-display">{{ section.settings.heading }}</h2>{%- endif -%}
  {%- if section.settings.text != blank -%}<p class="campaign__text">{{ section.settings.text }}</p>{%- endif -%}
  {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="campaign__cta">{{ section.settings.cta_label }}</a>{%- endif -%}
{%- endcapture -%}

{%- if style == 'background' -%}
  <section class="campaign campaign--bg campaign--pos-{{ section.settings.text_position }}" style="--camp-text:{{ section.settings.text_color }};--camp-overlay:{{ section.settings.overlay_opacity | divided_by: 100.0 }};">
    <div class="campaign__bg-media">
      {%- if section.settings.bg_image != blank -%}
        <img class="campaign__bg-img campaign__bg-img--d" src="{{ section.settings.bg_image | image_url: width: 2000 }}" srcset="{{ section.settings.bg_image | image_url: width: 1200 }} 1200w, {{ section.settings.bg_image | image_url: width: 2000 }} 2000w" sizes="100vw" alt="{{ section.settings.bg_image.alt | default: section.settings.heading | escape }}" width="{{ section.settings.bg_image.width }}" height="{{ section.settings.bg_image.height }}" loading="lazy">
      {%- endif -%}
      {%- if section.settings.bg_image_mobile != blank -%}
        <img class="campaign__bg-img campaign__bg-img--m" src="{{ section.settings.bg_image_mobile | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
      {%- endif -%}
    </div>
    <div class="campaign__scrim" aria-hidden="true"></div>
    <div class="campaign__inner container"><div class="campaign__center">{{ center }}</div></div>
  </section>
{%- else -%}
  <section class="campaign campaign--split" style="--camp-bg:{{ section.settings.bg }};">
    <div class="campaign__grid container">
      <div class="campaign__side campaign__side--left">
        {%- if section.settings.left_image != blank -%}
          <img src="{{ section.settings.left_image | image_url: width: 800 }}" alt="{{ section.settings.left_image.alt | escape }}" width="{{ section.settings.left_image.width }}" height="{{ section.settings.left_image.height }}" loading="lazy">
        {%- elsif section.settings.left_default != blank -%}
          <img src="{{ section.settings.left_default | asset_url }}" alt="" loading="lazy">
        {%- endif -%}
      </div>
      <div class="campaign__center">{{ center }}</div>
      <div class="campaign__side campaign__side--right">
        {%- if section.settings.right_image != blank -%}
          <img src="{{ section.settings.right_image | image_url: width: 800 }}" alt="{{ section.settings.right_image.alt | escape }}" width="{{ section.settings.right_image.width }}" height="{{ section.settings.right_image.height }}" loading="lazy">
        {%- elsif section.settings.right_default != blank -%}
          <img src="{{ section.settings.right_default | asset_url }}" alt="" loading="lazy">
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}
{% schema %}
{
  "name": "Campaign Banner",
  "settings": [
    { "type": "select", "id": "style", "label": "Style", "options": [{"value":"split","label":"Image · Text · Image"},{"value":"background","label":"Full background image"}], "default": "split" },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wisdom and Nourish" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Wisdom cards, rose water and botanical care. Considered objects for the everyday." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Explore the Collection" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "header", "content": "Split images" },
    { "type": "image_picker", "id": "left_image", "label": "Left image" },
    { "type": "text", "id": "left_default", "label": "Left fallback (bundled filename)" },
    { "type": "image_picker", "id": "right_image", "label": "Right image" },
    { "type": "text", "id": "right_default", "label": "Right fallback (bundled filename)" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#e8ddd2" },
    { "type": "header", "content": "Background style" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image (desktop)" },
    { "type": "image_picker", "id": "bg_image_mobile", "label": "Background image (mobile)" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay strength", "min": 0, "max": 70, "step": 5, "unit": "%", "default": 25 },
    { "type": "color", "id": "text_color", "label": "Text colour (background style)", "default": "#3d2418" },
    { "type": "select", "id": "text_position", "label": "Text position (background style)", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"}], "default": "center" }
  ],
  "presets": [{ "name": "Campaign Banner" }]
}
{% endschema %}
