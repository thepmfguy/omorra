<section id="pillars" class="world-section">
  <div class="container">
    <div class="world-intro">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="world-heading font-display">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p class="world-sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="world-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign coll = block.settings.collection
          assign url = block.settings.link
          if coll != blank and url == blank
            assign url = coll.url
          endif
          assign label = block.settings.label
          if label == blank and coll != blank
            assign label = coll.title
          endif
        -%}
        <article class="world-card" {{ block.shopify_attributes }}>
          <a href="{{ url | default: '#' }}" class="world-card__media"{% if label != blank %} aria-label="{{ label | escape }}"{% endif %}>
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 900 }}"
                   srcset="{{ block.settings.image | image_url: width: 500 }} 500w, {{ block.settings.image | image_url: width: 900 }} 900w, {{ block.settings.image | image_url: width: 1200 }} 1200w"
                   sizes="(min-width:900px) 33vw, 100vw"
                   alt="{{ block.settings.image.alt | default: label | escape }}"
                   width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">
            {%- elsif block.settings.default_asset != blank -%}
              <img src="{{ block.settings.default_asset | asset_url }}" alt="{{ label | escape }}" width="600" height="450" loading="lazy">
            {%- endif -%}
          </a>
          <div class="world-card__body">
            {%- if label != blank -%}<h3 class="world-card__label font-display">{{ label }}</h3>{%- endif -%}
            {%- if block.settings.lead != blank -%}<p class="world-card__lead">{{ block.settings.lead }}</p>{%- endif -%}
            {%- if block.settings.text != blank -%}<p class="world-card__text">{{ block.settings.text }}</p>{%- endif -%}
            {%- if block.settings.cta_label != blank -%}
              <a href="{{ url | default: '#' }}" class="world-card__cta">{{ block.settings.cta_label }}</a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "The World of Omorra",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The World of Omorra" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wisdom. Practice. Nourish." },
    { "type": "textarea", "id": "subheading", "label": "Sub-heading", "default": "Three expressions of considered living: what we reflect upon, how we move, and how we care." }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "default_asset", "label": "Fallback image (bundled filename)" },
        { "type": "collection", "id": "collection", "label": "Collection (sets the link)" },
        { "type": "url", "id": "link", "label": "Custom link (optional, overrides collection)" },
        { "type": "text", "id": "label", "label": "Label", "info": "Defaults to the collection title" },
        { "type": "text", "id": "lead", "label": "Lead line" },
        { "type": "textarea", "id": "text", "label": "Description" },
        { "type": "text", "id": "cta_label", "label": "CTA label" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "The World of Omorra",
      "blocks": [
        { "type": "panel", "settings": { "default_asset": "wisdom-cards.png", "label": "Wisdom", "lead": "For the inner life.", "text": "Reflections and objects that invite a more considered inner life.", "cta_label": "Explore Wisdom" } },
        { "type": "panel", "settings": { "default_asset": "practice-mat.png", "label": "Practice", "lead": "For the body.", "text": "Objects that support movement, stillness and daily practice.", "cta_label": "Explore Practice" } },
        { "type": "panel", "settings": { "default_asset": "cat-nourish.png", "label": "Nourish", "lead": "For everyday care.", "text": "Botanical rituals informed by the traditions of Ayurveda.", "cta_label": "Explore Nourish" } }
      ]
    }
  ]
}
{% endschema %}
