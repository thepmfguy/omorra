<div class="container" style="max-width:720px;padding-top:4rem;padding-bottom:5rem;">
  <header style="margin-bottom:2rem;">
    <h1 class="font-display" style="font-weight:500;font-size:clamp(2.2rem,4vw,3.4rem);color:var(--ink);line-height:1.1;">{{ page.title }}</h1>
  </header>
  {%- if page.content != blank -%}
    <div class="rte" style="font-size:1.05rem;line-height:1.8;color:var(--ink);">{{ page.content }}</div>
  {%- endif -%}
</div>
{% schema %}
{ "name": "Page", "settings": [] }
{% endschema %}
